### E-commerce API Tests - Fixed Format
### Make sure REST Client extension is installed
### Click "Send Request" that appears above each request

###
# Test 1: API Documentation
GET http://localhost:5001/

###
# Test 2: Register User
POST http://localhost:5001/auth/register
content-type: application/json

{
  "name": "REST Client User",
  "email": "restclient@example.com",
  "address": "123 REST Street",
  "password": "password123"
}

###
# Test 3: Login User (use same email as registration)
POST http://localhost:5001/auth/login
content-type: application/json

{
  "email": "restclient@example.com",
  "password": "password123"
}

###
# Test 4: Get Products (Public)
GET http://localhost:5001/products?page=1&per_page=5

###
# Test 5: Get Profile (Replace YOUR_TOKEN with token from registration/login)
GET http://localhost:5001/auth/profile
Authorization: Bearer YOUR_TOKEN

###
# Test 6: Create Product (Replace YOUR_TOKEN)
POST http://localhost:5001/products
content-type: application/json
Authorization: Bearer YOUR_TOKEN

{
  "product_name": "Test Laptop",
  "price": 999.99
}

###
# Test 7: Create Order (Replace YOUR_TOKEN)
POST http://localhost:5001/orders
content-type: application/json
Authorization: Bearer YOUR_TOKEN

{
  "product_ids": [1],
  "shipping_address": "123 REST Street",
  "notes": "Test order via REST Client"
}

###
# Test 8: Get User Orders (Replace YOUR_TOKEN and user_id)
GET http://localhost:5001/orders/user/9?page=1&per_page=10
Authorization: Bearer YOUR_TOKEN

###
# Test 9: Update Order Status (Replace YOUR_TOKEN and order_id)
PUT http://localhost:5001/orders/1/status
content-type: application/json
Authorization: Bearer YOUR_TOKEN

{
  "status": "confirmed"
}

###
# Test 10: Search Products
GET http://localhost:5001/products?search=laptop&page=1&per_page=5
